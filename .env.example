# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
# Users configure this via the Secrets panel in the AI Studio UI.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
# AI Studio automatically injects this at runtime with the Cloud Run service URL.
# Used for self-referential links, OAuth callbacks, and API endpoints.
APP_URL="MY_APP_URL"

# TESSERACT_CMD (optional): Full path to the Tesseract executable when it is not
# on PATH and not in a standard install location. Examples:
#   Windows: TESSERACT_CMD="C:\Program Files\Tesseract-OCR\tesseract.exe"
#   Linux:   TESSERACT_CMD="/usr/bin/tesseract"
# Tamil/English traineddata files are read from engines/tessdata. The bundled
# Tamil model is the higher-accuracy tessdata_best build; additional languages
# downloaded from the Manage Languages dialog use tessdata_best too (send
# quality: "fast" to the download endpoint for the smaller, quicker models).
# TESSERACT_CMD=""

# PDF rasterization (optional). Scanned PDFs are rasterized with pdftoppm before
# OCR. PDF_DPI trades quality for speed (raise for sharper pages, lower to open
# large volumes faster). PDF_WORKERS splits the page range across parallel
# pdftoppm processes — defaults to the CPU core count (max 8).
# PDF_DPI="200"
# PDF_WORKERS="4"

# PDFTOPPM_BIN / PDFINFO_BIN (optional): full paths to the poppler binaries when
# they are not on PATH. Example (Windows):
#   PDFTOPPM_BIN="C:\poppler-24.08.0\Library\bin\pdftoppm.exe"
#   PDFINFO_BIN="C:\poppler-24.08.0\Library\bin\pdfinfo.exe"
# PDFTOPPM_BIN=""
# PDFINFO_BIN=""

# Uploads and storage (optional).
#
# PULAN_MAX_UPLOAD_MB caps a single uploaded file. Uploads stream straight to disk, so a
# large file costs time and space rather than memory, and scanned Tamil books routinely
# run to hundreds of megabytes and thousands of pages. The default is deliberately
# generous; lower it to refuse oversized uploads, raise it for anything bigger.
#
# Before rasterizing a PDF the server estimates the PNGs it will produce (about 2.5 MB
# per page at 200 DPI) and refuses to start if the temp folder cannot hold them, rather
# than failing part way through with a disk-full error. Lower PDF_DPI above to make a very
# large volume fit.
# PULAN_MAX_UPLOAD_MB="4096"
#
# PULAN_TEMP_DIR holds uploads and rasterized pages, and PULAN_DIAGNOSTICS_DIR holds the
# diagnostics records and image artifacts. Both default to somewhere sensible (the system
# temp folder, and ./diagnostics); both need to be writable by the process. The packaged
# desktop app points them at the user's own data folder, because Program Files is not
# writable.
# PULAN_TEMP_DIR=""
# PULAN_DIAGNOSTICS_DIR=""

# PYTHON_BIN (optional): the Python interpreter used for the OCR engine, when the
# 'python' (Windows) or 'python3' (POSIX) on PATH is not the one you want. The packaged
# desktop app points this at the embedded Python it ships with.
# PYTHON_BIN=""

# PORT (optional): the port the API listens on. Defaults to 3000; the packaged desktop app
# picks a free port at launch and passes it here.
# PORT=""

# ---------------------------------------------------------------------------
# AI vision engines (layout detection and OCR through a vision model)
#
# Three engines are available in the toolbar: Claude, ChatGPT and any
# OpenAI-compatible endpoint. Keys can also be pasted in the engine options
# panel, where they stay in the browser; the variables below configure them
# server-side instead. No key is ever logged.
# ---------------------------------------------------------------------------

# Anthropic Claude (engine "Claude (Anthropic) Vision")
# Leave the key empty and tick "Subscription" to use your Claude Pro/Max
# subscription through Claude Code instead (see the subscription section below).
# ANTHROPIC_API_KEY="sk-ant-..."
# ANTHROPIC_MODEL="claude-sonnet-4-5"
# ANTHROPIC_BASE_URL=""            # only for a proxy or gateway

# OpenAI ChatGPT (engine "ChatGPT (OpenAI) Vision")
# OPENAI_API_KEY="sk-..."
# OPENAI_MODEL="gpt-4o"
# OPENAI_BASE_URL=""               # only for a proxy or gateway

# Any OpenAI-compatible endpoint: Ollama, LM Studio, vLLM, OpenRouter, Groq,
# Together, DeepSeek, an Azure-style gateway, ...
# Examples:
#   PULAN_AI_BASE_URL="http://localhost:11434/v1"    # Ollama
#   PULAN_AI_BASE_URL="http://localhost:1234/v1"     # LM Studio
#   PULAN_AI_BASE_URL="https://openrouter.ai/api/v1" # OpenRouter
# PULAN_AI_BASE_URL=""
# PULAN_AI_MODEL=""                # e.g. qwen2.5vl:7b, llama3.2-vision, gpt-4o-mini
# PULAN_AI_API_KEY=""              # only when the endpoint needs one

# ---------------------------------------------------------------------------
# Subscription use without an API key
#
# Claude: tick "Subscription" in the engine options panel and press "Sign in". The
# app runs the Claude Agent SDK (pip install claude-agent-sdk), which drives the
# Claude Code CLI that the SDK ships with — and it drives that CLI's own sign-in for
# you: the panel shows the authorization link and takes the code, so no terminal is
# ever needed. "Sign out" is in the same panel.
# ANTHROPIC_API_KEY and ANTHROPIC_AUTH_TOKEN are deliberately removed from the
# environment handed to that CLI, so your subscription is used rather than the
# API, and ANTHROPIC_BASE_URL is removed too. This app never reads, copies or
# stores your credentials. Press "Check sign-in" in the toolbar to verify it.
#
# ChatGPT: tick "Subscription" as well; that path signs in to the codex CLI the same
# way, from inside the app, and needs the CLI installed:
#     npm install -g @openai/codex
#
# Google: tick "Subscription" too. That path runs through the Antigravity CLI, not the
# Gemini CLI — Google retired the Gemini CLI for individual plans, Google AI Pro
# included, and pointed users at Antigravity instead. Install it with:
#     irm https://antigravity.google/cli/install.ps1 | iex      (Windows PowerShell)
# It usually needs no sign-in step at all: it reads the Google credential the
# Antigravity app already stored in the operating system keyring.
# ---------------------------------------------------------------------------

# PULAN_CLAUDE_CLI (optional): path to a specific claude executable. Leave unset
# to use the CLI bundled with the claude-agent-sdk package (the default), then
# PATH, then the usual install locations. On Windows the SDK refuses npm's
# claude.cmd shim, so point this at a native claude.exe if you install your own.
# PULAN_CLAUDE_CLI=""

# CODEX_CLI_BIN (optional): name or path of the codex executable.
# CODEX_CLI_BIN="codex"

# AGY_CLI_BIN (optional): name or path of the Antigravity CLI (agy). Leave unset to
# use the location its own installer chose (%LOCALAPPDATA%\agy\bin on Windows,
# ~/.local/bin elsewhere), then PATH.
# AGY_CLI_BIN=""

# GEMINI_MODEL (optional): the model the Google subscription asks for. Left unset, the
# app asks for Gemini 3.8 Flash at low reasoning effort, which reads one page in about
# 25 seconds. Naming a model here also stops the app passing that effort setting, so a
# name carrying its own effort (…-high, …-medium, …-low) is the safer choice.
# GEMINI_MODEL=""

# Claude subscription backend (optional).
# PULAN_AGENT_TIMEOUT_MS: how long one page may take (default 240000).
# PULAN_AGENT_IDLE_MS: how long an idle sidecar is kept before it is shut down
#   (default 600000). The sidecar is one Python process; it holds one `claude`
#   process per conversation and stops both when it exits.
# PULAN_AGENT_WORKDIR: the empty folder Claude Code runs in. Defaults to an
#   application-data folder, never the project or your home directory.
# PULAN_AGENT_MAX_IMAGE_EDGE: long edge a page is scaled to before the model sees
#   it (default 1600). A page image travels through a tool, and the Agent SDK caps a
#   message at 1 MB, so this is what keeps a 200 DPI scan from failing. Larger is
#   slower and mostly discarded by the vision model anyway.
# PULAN_AGENT_MAX_BUFFER: the Agent SDK's per-message limit, raised from its 1 MB
#   default so a dense scan still fits (default 64 MB).
# PULAN_AGENT_TIMEOUT_MS="240000"
# PULAN_AGENT_IDLE_MS="600000"
# PULAN_AGENT_WORKDIR=""
# PULAN_AGENT_MAX_IMAGE_EDGE="1600"
# PULAN_AGENT_MAX_BUFFER="67108864"

# Vision request budget (optional). The timeout covers one layout/OCR request.
# PULAN_AI_TIMEOUT_MS="180000"
# PULAN_AI_MAX_TOKENS="8000"


